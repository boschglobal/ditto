<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.ditto</groupId>
        <artifactId>ditto-bom</artifactId>
        <version>${revision}</version>
        <relativePath>../bom/pom.xml</relativePath>
    </parent>
    <artifactId>ditto-ide-postgres-launcher</artifactId>
    <packaging>jar</packaging>
    <name>Eclipse Ditto :: IDE PostgreSQL Launcher</name>

    <!--
        LOCAL-DEV / IDE ONLY — this module ships no code and is never published or bundled.

        Its sole purpose is to give the IntelliJ "(Postgres)" run configurations one module whose classpath carries
        BOTH a service (things/policies/connectivity) AND the PostgreSQL persistence backend
        (ditto-internal-utils-persistence-r2dbc: the provider, the journal/snapshot plugin classes, the
        ditto-postgres-*.conf profile resources and the r2dbc driver).

        Why this module exists instead of a dependency on the service itself:
          * The service modules deliberately do NOT depend on r2dbc — the `enforce-no-r2dbc-in-service` rule keeps
            it out of their shaded allinones, because PostgreSQL ships in production as the separate drop-in
            ditto-internal-utils-persistence-r2dbc-extension JAR.
          * An IntelliJ "Application" run configuration uses only a module's PRODUCTION (compile/runtime) classpath,
            never its test scope, so a test-scope r2dbc dependency on the service would never reach the run
            classpath.
        Pointing the "(Postgres)" run configs' "Use classpath of module" at THIS module (while keeping the
        service's own main class, e.g. org.eclipse.ditto.policies.service.starter.PoliciesService) puts r2dbc on the
        production/compile classpath without touching the service modules or their allinones.

        Leak-free by construction: this module is never listed in any service's maven-shade artifact set, and the
        `enforce-no-r2dbc-in-service` rules are scoped to the service modules, so carrying r2dbc here at compile
        scope cannot reach a published service image.
    -->

    <properties>
        <!-- Dev-only aggregator: never deploy this (essentially empty) jar to a repository. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            The services whose "(Postgres)" run configs point their classpath at this module. Each contributes its
            own main class + service config (e.g. policies.conf with read-journal.entity="policies").
        -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-policies-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-things-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-connectivity-service</artifactId>
        </dependency>
        <!--
            The PostgreSQL persistence backend the run configs need on the classpath: PostgresPersistenceBackendProvider
            (selected by the *-pg-dev.conf overlay), the Postgres journal/snapshot plugin classes, the
            ditto-postgres-persistence.conf profile (provider wiring + client/pool/SSL defaults), and the
            r2dbc-postgresql driver + pool.
        -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-persistence-r2dbc</artifactId>
        </dependency>
    </dependencies>
</project>
